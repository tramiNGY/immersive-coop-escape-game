# =============== Blender ================

# Ignore Blender temporary files
BlenderSources/*.blend1
BlenderSources/*.blend2
BlenderSources/*.blend@

# Ignore the entire BlenderSources folder to not version .blend sources
/BlenderSources/

# Ignore the entire AssetSources folder to not version .blend and FBX sources from free original assets
/AssetSources/

# Ignore the entire Builds folder to not version .exe builds from Unity
/Builds/

